{
  "sourceUrl": "https://Subsonic.example.org",
  "sourceName": "Subsonic",
  "version": "1.2.0",
  "author": "BBeBee",
  "sourceGroup": "self-hosted,subsonic",
  "sourceComment": "Subsonic-compatible music server. Host is configured via sourceUrl; credentials user and password are provided via loginUi.",
  "variableComment": "username:password",
  "concurrentRate": "5/1000",
  "params": [
    "sourceurl",
    "username",
    "password"
  ],
  "loginUi": [
    {
      "id": "user",
      "label": "Username",
      "type": "text"
    },
    {
      "id": "password",
      "label": "Password",
      "type": "password"
    }
  ],
  "loginType": "form",
  "loginUrl": "{{source.url}}/rest/ping.view?u={{login.user}}&p={{login.password}}&v=1.16.1&c=BBeBee&f=json",
  "loginCheckJs": "@js:\n// Check if Subsonic response status is ok\nconst res = (result && result['subsonic-response']) || result;\nreturn Boolean(res && res.status === 'ok');",
  "searchUrl": "{{source.url}}/rest/search3.view?query={{key}}&songCount=50&songOffset={{@js:(page-1)*50}}&{{@js:auth()}}",
  "exploreUrl": "[{\"title\":\"Recently added\",\"url\":\"{{source.url}}/rest/getAlbumList2.view?type=newest&size=100&offset={{@js:(page-1)*100}}&{{@js:auth()}}\"},{\"title\":\"Alphabetical\",\"url\":\"{{source.url}}/rest/getAlbumList2.view?type=alphabeticalByName&size=100&offset={{@js:(page-1)*100}}&{{@js:auth()}}\"}]",
  "recommendUrl": "{{source.url}}/rest/getIndexes.view?{{@js:auth()}}",
  "ruleRecommend": {
    "trackList": "@js:\nreturn buildRecommendList(result);",
    "trackId": "$.id",
    "title": "$.name || $.title",
    "artist": "$.artist",
    "kind": "=album",
    "artwork": "={{source.url}}/rest/getCoverArt.view?id={{item.coverArt}}&{{@js:auth()}}",
    "childUrl": "$.childUrl"
  },
  "ruleSearch": {
    "trackList": "$.subsonic-response.searchResult3.song[*]",
    "trackId": "$.id",
    "title": "$.title",
    "artist": "$.artist",
    "album": "$.album",
    "albumId": "$.albumId",
    "durationMs": "$.duration##$##000",
    "artwork": "={{source.url}}/rest/getCoverArt.view?id={{item.coverArt}}&{{@js:auth()}}",
    "quality": "$.suffix"
  },
  "ruleStream": {
    "url": "={{source.url}}/rest/stream.view?id={{track.id}}&{{@js:auth()}}",
    "seekable": "=true"
  },
  "ruleExplore": {
    "trackList": "$.subsonic-response.albumList2.album[*]",
    "trackId": "$.id",
    "title": "$.name",
    "artist": "$.artist",
    "kind": "=album",
    "artwork": "={{source.url}}/rest/getCoverArt.view?id={{item.coverArt}}&{{@js:auth()}}",
    "childUrl": "={{source.url}}/rest/getAlbum.view?id={{item.id}}&{{@js:auth()}}"
  },
  "ruleTrackList": {
    "trackList": "@js:\n// Extract songs from directory, indexes, or album response\nreturn getDirectorySongs(result);",
    "trackId": "$.id",
    "title": "$.title",
    "artist": "$.artist",
    "album": "$.album",
    "albumId": "$.albumId",
    "durationMs": "$.duration##$##000",
    "artwork": "={{source.url}}/rest/getCoverArt.view?id={{item.coverArt}}&{{@js:auth()}}",
    "quality": "$.suffix"
  },
  "ruleAlbum": {
    "title": "$.subsonic-response.directory.name || $.subsonic-response.album.name || =默认歌单",
    "artist": "$.subsonic-response.directory.artist || $.subsonic-response.album.artist || =Subsonic",
    "year": "$.subsonic-response.album.year",
    "trackCount": "$.subsonic-response.album.songCount"
  },
  "ruleLyric": {
    "lyric": "={{source.url}}/rest/getLyrics.view?artist={{track.artist}}&title={{track.title}}&{{@js:auth()}}"
  }
}
